{
  "expo": {
    "name": "Interview Simulator",
    "slug": "interview-simulator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "interview-simulator",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.interviewsimulator.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for eye tracking during interviews to measure attention.",
        "NSMicrophoneUsageDescription": "Microphone is used to record voice answers during interviews."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.interviewsimulator.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Interview Simulator to access your camera for eye tracking."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Interview Simulator to access your microphone for voice answers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
